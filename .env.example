# Copy to .env and set the path to your own service-account JSON file.
# Relative paths resolve from the project folder, including launches from an IDE.
FCM_PROJECT_ID=sap-for-me-android-internal
GOOGLE_APPLICATION_CREDENTIALS=./credentials/fcm-service-account.json

# Optional short-lived OAuth access token; when set, takes priority over JSON credentials.
# FCM_ACCESS_TOKEN=
